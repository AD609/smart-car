#include	"stm32f10x.h"                  // Device header
#include	"OLED.h"
#include	"PWM.h"
#include	"Motor.h"
#include	"Delay.h"
#include	"SERVO.h"
#include	"HCSOR04.h"

extern uint16_t Time;    //HCSOR04.c 里的原始计数，用来算 0.1cm 位

uint16_t distance;

int main(void)
{
		PWM_Init();
		Motor_Init();
		OLED_Init();
		Servo_Init();
		HCSOR_Init();

		OLED_ShowString(1,1,"dis:");
		OLED_ShowString(1,8,".");
		OLED_ShowString(1,10,"cm");

	while(1)
	{

//		Servo_Angle(0);
//		Delay_ms(1000);
//		Servo_Angle(90);
//		Delay_ms(1000);
//		Servo_Angle(180);
//		Delay_ms(1000);


//		Motor_L_Speed(50);
//		Delay_s(2);
//		Motor_R_Speed(50);
//		Delay_s(2);
//		Motor_Differential(40,80);

		distance =	HCSR04_GetValue();

		OLED_ShowNum(1,5,distance,3);               //整数部分，3位
		OLED_ShowNum(1,9,Time * 17 % 10,1);         //0.1cm位（0.1ms计数：mm=Time*17）

	}

}
